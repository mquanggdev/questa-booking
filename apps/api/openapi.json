        ],
        "summary": "Holds numbered seats and/or standing tickets and creates a PENDING order.\nRetrying with the same Idempotency-Key returns the same order (with the\nheader Idempotent-Replayed: true) instead of holding more tickets.",
        "tags": [
          "reservations"
        ]
