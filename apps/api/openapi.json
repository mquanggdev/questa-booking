  "info": {
    "title": "Questa Booking API",
    "description": "High-concurrency concert ticketing. Errors are always { code, message, details? }.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Jane Doe"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "role": {
            "enum": [
              "CUSTOMER",
              "ORGANIZER",
              "STAFF"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT to send as \"Authorization: Bearer <token>\""
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "PerformanceSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CANCELLED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "venue",
          "startsAt",
          "status"
        ]
      },
      "ConcertResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "performances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PerformanceSummaryDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "artist",
          "description",
          "performances"
        ]
      },
      "ConcertPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConcertResponseDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "CreateConcertDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
