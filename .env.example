# Copy to .env for local development: cp .env.example .env
# docker compose reads this file; the API reads it when run on the host.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Pretty logs when running the API on the host (pino-pretty is a dev dependency)
LOG_PRETTY=true

# PostgreSQL
POSTGRES_USER=questa
POSTGRES_PASSWORD=questa
POSTGRES_DB=questa
# 5433 on the host so it never collides with a locally installed PostgreSQL
POSTGRES_PORT=5433
# Host-side URL (API run with pnpm). Inside compose the API uses host "postgres".
DATABASE_URL=postgresql://questa:questa@localhost:5433/questa

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Database pool per process, and how long a transaction waits for a connection
# before the request is shed with 503
DB_POOL_MAX=10
DB_TX_MAX_WAIT_MS=2000
DB_TX_TIMEOUT_MS=10000

# Host port for the API container (change it if 3000 is taken on your machine)
API_PORT=3000

# Auth
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true only behind HTTPS
COOKIE_SECURE=false
SWAGGER_ENABLED=true
# Reservation hold before the order expires (seconds)
HOLD_TTL_SECONDS=600
# Extra time after expires_at before an unpaid order is released
PAYMENT_GRACE_SECONDS=120
# Redis filter in front of the database (false = phase 3 behaviour)
RESERVATION_GATE_ENABLED=true
# Worker schedules (ms): sweep overdue orders, repair Redis standing counters
SWEEP_EVERY_MS=60000
RECONCILE_EVERY_MS=30000
# How seats are locked when held: conditional | pessimistic | optimistic (ADR-0008)
SEAT_HOLD_STRATEGY=conditional

# Seed (development and load tests only)
SEED_PASSWORD=Questa@2026
LOADTEST_TOKEN_TTL_SECONDS=43200

# Payments (phase 5)
# fake = local simulated gateway speaking the VNPay protocol; vnpay = VNPay sandbox
PAYMENT_PROVIDER=fake
# The Docker stack runs NODE_ENV=production: the fake gateway must be allowed
# explicitly. Never set this on a public deployment.
ALLOW_FAKE_PAYMENTS=true
FAKE_PAYMENT_SECRET=local-fake-gateway-secret
# Base URL of this API as seen by browsers and by the gateway (IPN callbacks)
PUBLIC_BASE_URL=http://localhost:3000
REFUND_MAX_ATTEMPTS=5
# VNPay sandbox: register at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
