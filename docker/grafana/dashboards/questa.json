    {
      "id": 11,
      "type": "timeseries",
      "title": "BullMQ: job theo queue",
      "description": "delayed = vé đang giữ chờ hết hạn; failed ở payments-dead-letter = hoàn tiền cần người xem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
