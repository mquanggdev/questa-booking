      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, consumer) (rate(questa_consumer_lag_seconds_bucket{job=\"worker\"}[1m])))",
          "legendFormat": "{{consumer}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sự kiện/s theo consumer và kết quả",
      "description": "duplicate = bản trùng bị bỏ qua (I7); dead-lettered = vào DLQ.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (consumer, outcome) (rate(questa_consumer_events_total{job=\"worker\"}[1m]))",
          "legendFormat": "{{consumer}} {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(questa_outbox_published_total{job=\"worker\"}[1m])",
          "legendFormat": "relay đã gửi"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Hàng đợi và hàng chờ",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
